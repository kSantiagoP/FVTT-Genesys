{
	"name": "genesys",
	"version": "1.0.0",
	"description": "Unofficial implementation of the Genesys RPG for Foundry",
	"repository": "https://github.com/kSantiagoP/FVTT-Genesys",
	"author": "kSantiagoP",
	"license": "MIT",
	"type": "module",
	"private": true,
	"scripts": {
		"build:data": "gulp",
		"build": "yarn build:data && vite build",
		"dev": "concurrently \"gulp watch\" \"vite\"",
		"watch:data": "gulp watch",
		"lint": "eslint src --ext .vue,.js,.ts",
		"format": "prettier --write src/ types/",
		"release": "yarn build && gulp zip",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@league-of-foundry-developers/foundry-vtt-types": "^13.346.0-beta.20250812191140",
		"@rushstack/eslint-patch": "^1.7.2",
		"@types/gulp": "^4.0.10",
		"@types/handlebars": "^4.1.0",
		"@types/jquery": "^3.5.29",
		"@types/node": "^18.11.18",
		"@vitejs/plugin-vue": "^5.2.4",
		"@vue/eslint-config-prettier": "^9.0.0",
		"@vue/eslint-config-typescript": "^12.0.0",
		"@yeger/vue-masonry-wall": "^5.0.6",
		"concurrently": "^7.6.0",
		"dotenv": "^16.0.3",
		"dotenv-expand": "^10.0.0",
		"eslint": "^8.56.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-vue": "^9.21.0",
		"gulp": "^4.0.2",
		"gulp-clean": "^0.4.0",
		"gulp-yaml": "^2.0.4",
		"gulp-zip": "^5.1.0",
		"handlebars": "^4.7.7",
		"prettier": "^3.2.4",
		"sass": "^1.70.0",
		"socket.io": "^4.6.0",
		"typescript": "^5.3.3",
		"vite": "^5.0.12",
		"vue": "^3.4.15",
		"vue-tsc": "^1.8.27"
	}
}
